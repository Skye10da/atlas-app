# WTR-Lab Google translate API key.
# Copy to `.env` (gitignored) and fill in, then build with:
#   flutter run --dart-define-from-file=.env
# The WtrWebTranslateService reads WTR_TRANSLATE_API_KEY at build time via
# String.fromEnvironment. When absent the service fails soft and chapters stay
# in their source language.
WTR_TRANSLATE_API_KEY=